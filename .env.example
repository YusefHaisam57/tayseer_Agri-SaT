# ============================================================
# Tayseer Agri-SaT — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# ============================================================

# ── Flask ─────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
HOST=0.0.0.0
PORT=5000

# ── Database ──────────────────────────────────────────────
DATABASE_PATH=tayseer_agri_sat.db

# ── Google Earth Engine ───────────────────────────────────
# Run: earthengine authenticate
# Then set your Google Cloud Project ID below
GEE_PROJECT_ID=your-gcloud-project-id

# ── Twilio WhatsApp Configuration ─────────────────────────
# Create account: https://www.twilio.com/try-twilio
# Sandbox number: https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Sandbox join phrase (shown in Twilio Sandbox dashboard)
TWILIO_SANDBOX_JOIN=join tayseer-demo

# Public webhook URL (use ngrok for local dev):
#   ngrok http 5000
#   → copy https URL → paste below
WEBHOOK_BASE_URL=https://your-domain.com
# Dev example: https://abcd-1234.ngrok-free.app

# ── Telegram Bot (optional) ───────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ── Email Notification System ────────────────────────────────
# Choose: smtp | sendgrid
EMAIL_PROVIDER=smtp
FROM_EMAIL=noreply@tayseer.app
FROM_NAME=Tayseer Agri-SaT
HOST_EMAIL=admin@tayseer.app
SUPPORT_EMAIL=support@tayseer.app

# Option A: Gmail SMTP (dev)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Option B: SendGrid (production)
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx

# ── OpenWeather API (optional) ────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_key
